// Generated by CMake from game.rc.in: the port executable's icon (ours, port/tools/make_icon.py)
// and version information. Plain ASCII only.
#include <windows.h>

1 ICON "@TTT2_SETUP_ICON@"

1 VERSIONINFO
FILEVERSION    @TTT2_VERSION_COMMAS@
PRODUCTVERSION @TTT2_VERSION_COMMAS@
FILEOS         0x4L
FILETYPE       0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "TTT2 Community Edition by Sheeda Musalli"
            VALUE "FileVersion",     "@TTT2_VERSION@"
            VALUE "ProductName",     "TTT2 Community Edition | Sheeda Musalli"
            VALUE "ProductVersion",  "@TTT2_VERSION@"
            VALUE "CompanyName",     "Sheeda Musalli"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
