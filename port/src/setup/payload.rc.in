// Generated by CMake from payload.rc.in -- the absolute paths are resolved at configure time.
// Plain ASCII only in this file (the resource compiler mangles escapes; Tom & Jerry lesson).
#include <windows.h>
#include "setup/payload_ids.h"

IDI_TTT2SETUP          ICON    "@TTT2_SETUP_ICON@"
1                      24      "@TTT2_SETUP_MANIFEST@"

IDR_GAME_EXE           RCDATA  "@TTT2_GAME_EXE@"
IDR_LAUNCHER_EXE       RCDATA  "@TTT2_LAUNCHER_EXE@"
@TTT2_STEAM_RESOURCE_LINE@
IDR_MSVCP140           RCDATA  "@CRT_MSVCP140@"
IDR_MSVCP140_ATOMIC    RCDATA  "@CRT_MSVCP140_ATOMIC@"
IDR_VCRUNTIME140       RCDATA  "@CRT_VCRUNTIME140@"
IDR_VCRUNTIME140_1     RCDATA  "@CRT_VCRUNTIME140_1@"
IDR_README             RCDATA  "@TTT2_README_TXT@"

IDD_MAIN DIALOGEX 0, 0, 640, 440
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TTT2 Community Edition | Sheeda Musalli"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_TTT2SETUP, IDC_BRAND_ICON, 22, 10, 34, 34
    LTEXT           "SHEEDA MUSALLI", IDC_BRAND, 66, 10, 210, 20
    LTEXT           "COMMUNITY EDITION", IDC_BRAND_TAG, 67, 30, 190, 14
    LTEXT           "TEKKEN TAG TOURNAMENT 2", IDC_HEADER_TITLE, 340, 10, 280, 23
    LTEXT           "INSTALLER  /  VERSION @TTT2_VERSION@", IDC_HEADER_SUBTITLE, 342, 34, 270, 14

    LTEXT           "Set up your game", IDC_INSTALL_TITLE, 24, 66, 590, 28
    LTEXT           "Select your legally obtained disc image and Title Update 3. TTT2 files and the launcher are installed together (about 13 GB).",
                    IDC_INSTALL_NOTE, 24, 96, 590, 30

    LTEXT           "01  /  DISC IMAGE (.ISO)", IDC_SOURCE_BADGE, 24, 137, 570, 14
    EDITTEXT        IDC_ISO_PATH, 24, 155, 500, 24, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_ISO_BROWSE, 536, 154, 78, 26, BS_OWNERDRAW | WS_TABSTOP

    LTEXT           "02  /  TITLE UPDATE 3", IDC_UPDATE_BADGE, 24, 196, 570, 14
    EDITTEXT        IDC_TU_PATH, 24, 214, 500, 24, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_TU_BROWSE, 536, 213, 78, 26, BS_OWNERDRAW | WS_TABSTOP

    LTEXT           "03  /  INSTALL LOCATION", IDC_DEST_BADGE, 24, 255, 570, 14
    EDITTEXT        IDC_DEST_PATH, 24, 273, 500, 24, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_DEST_BROWSE, 536, 272, 78, 26, BS_OWNERDRAW | WS_TABSTOP

    CONTROL         "Create a &Desktop shortcut", IDC_SC_DESKTOP, "Button",
                    BS_OWNERDRAW | WS_TABSTOP, 24, 312, 205, 18
    CONTROL         "Add to the &Start menu", IDC_SC_STARTMENU, "Button",
                    BS_OWNERDRAW | WS_TABSTOP, 250, 312, 205, 18
    CONTROL         "", IDC_PROGRESS, "msctls_progress32", WS_BORDER, 24, 346, 590, 14
    LTEXT           "Ready when you are.", IDC_STATUS, 24, 367, 400, 18
    LTEXT           "Local install  /  Saves stay in your Windows user profile", IDC_FOOTER, 24, 410, 390, 16
    PUSHBUTTON      "Install TTT2", IDC_INSTALL, 440, 402, 105, 28, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Exit", IDCANCEL, 553, 402, 61, 28, BS_OWNERDRAW | WS_TABSTOP
END

IDD_UNINSTALL DIALOGEX 0, 0, 520, 245
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Remove TTT2 Community Edition | Sheeda Musalli"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_TTT2SETUP, IDC_UN_ICON, 22, 10, 34, 34
    LTEXT           "SHEEDA MUSALLI", IDC_UN_BRAND, 66, 10, 390, 20
    LTEXT           "Remove TTT2 Community Edition", IDC_UN_TITLE, 66, 32, 390, 22
    LTEXT           "", IDC_UN_TEXT, 22, 74, 476, 55
    CONTROL         "Also delete my &saved games, profiles and settings", IDC_UN_KEEPSAVES, "Button",
                    BS_OWNERDRAW | WS_TABSTOP, 22, 145, 390, 18
    CONTROL         "", IDC_PROGRESS, "msctls_progress32", WS_BORDER, 22, 177, 476, 14
    PUSHBUTTON      "Remove", IDOK, 366, 201, 70, 28, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 446, 201, 52, 28, BS_OWNERDRAW | WS_TABSTOP
END

1 VERSIONINFO
FILEVERSION    @TTT2_VERSION_COMMAS@
PRODUCTVERSION @TTT2_VERSION_COMMAS@
FILEOS         0x4L
FILETYPE       0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "TTT2 Community Installer by Sheeda Musalli"
            VALUE "FileVersion",     "@TTT2_VERSION@"
            VALUE "ProductName",     "TTT2 Community Edition | Sheeda Musalli"
            VALUE "ProductVersion",  "@TTT2_VERSION@"
            VALUE "CompanyName",     "Sheeda Musalli"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
